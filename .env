# =============================================================================
# ABS-WEB - CONFIGURATION GLOBALE
# =============================================================================
# Ce fichier est le centre de contrôle de toute l'application.
# Toutes les variables définies ici ont priorité sur les configurations locales.
# =============================================================================

# =============================================================================
# DOMAINES ET HOSTS
# =============================================================================
# Domaine principal de l'application
APP_DOMAIN=local

# Sous-domaines pour chaque service
FRONTEND_HOST=app.local
BACKEND_HOST=api.local
AUTH_HOST=auth.local
MAIL_HOST=mail.local
TRAEFIK_HOST=traefik.local

# =============================================================================
# ENVIRONNEMENT
# =============================================================================
# development | staging | production
APP_ENV=development
NODE_ENV=development

# =============================================================================
# VERSIONS DES SERVICES
# =============================================================================

# --- Extra Services ---
TRAEFIK_VERSION=latest
KEYCLOAK_VERSION=26.0
POSTGRES_KEYCLOAK_VERSION=16
GREENMAIL_VERSION=2.0.1
ROUNDCUBE_VERSION=1.6.x-apache

# --- Frontend ---
NODE_VERSION=22
REDIS_FRONTEND_VERSION=7
NGINX_FRONTEND_VERSION=1.27

# --- Backend ---
PHP_VERSION=8.3
NGINX_BACKEND_VERSION=1.27
MYSQL_VERSION=8.0
POSTGRES_VERSION=16
MONGO_VERSION=7
REDIS_BACKEND_VERSION=7
RABBITMQ_VERSION=4.0

# =============================================================================
# PORTS - TRAEFIK (Point d'entrée central)
# =============================================================================
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080

# =============================================================================
# PORTS - FRONTEND
# =============================================================================
FRONTEND_DEV_PORT=5173
FRONTEND_PREVIEW_PORT=4173
FRONTEND_PROD_PORT=3000
REDIS_FRONTEND_PORT=6380

# =============================================================================
# PORTS - BACKEND
# =============================================================================
BACKEND_PORT=8000
MYSQL_PORT=3306
MYSQL_TEST_PORT=3307
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
MONGO_PORT=27017
MONGO_TEST_PORT=27018
REDIS_BACKEND_PORT=6379
ADMINER_PORT=8081
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# =============================================================================
# PORTS - EXTRA SERVICES
# =============================================================================
KEYCLOAK_PORT=8180
KEYCLOAK_HTTPS_PORT=8443
POSTGRES_KEYCLOAK_PORT=5434
GREENMAIL_SMTP_PORT=25
GREENMAIL_SMTPS_PORT=465
GREENMAIL_IMAP_PORT=143
GREENMAIL_IMAPS_PORT=993
GREENMAIL_POP3_PORT=110
GREENMAIL_POP3S_PORT=995
GREENMAIL_API_PORT=8082
ROUNDCUBE_PORT=8083
INBOUND_PARSE_PORT=8084
INBOUND_PARSE_SMTP_PORT=2525

# =============================================================================
# KEYCLOAK
# =============================================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=abs-app
KEYCLOAK_FRONTEND_CLIENT=abs-frontend
KEYCLOAK_BACKEND_CLIENT=abs-backend

# Base de données Keycloak
KEYCLOAK_DB_HOST=postgres-keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_secret

# =============================================================================
# GREENMAIL - UTILISATEURS PAR DÉFAUT
# =============================================================================
# Format: user:password@domain
GREENMAIL_USER1=user1:password1@mail.local
GREENMAIL_USER2=user2:password2@mail.local
GREENMAIL_USER3=user3:password3@mail.local
GREENMAIL_USER4=user4:password4@mail.local
GREENMAIL_USER5=user5:password5@mail.local
GREENMAIL_MAIL_DOMAIN=mail.local

# =============================================================================
# ROUNDCUBE
# =============================================================================
ROUNDCUBE_DEFAULT_HOST=greenmail
ROUNDCUBE_SMTP_SERVER=greenmail
ROUNDCUBE_SMTP_PORT=25
ROUNDCUBE_IMAP_PORT=143

# =============================================================================
# INBOUND PARSE (Simulateur SendGrid)
# =============================================================================
# Le fichier de configuration est dans extra-services/docker/inbound-parse/config.json
INBOUND_PARSE_LOG_LEVEL=debug

# =============================================================================
# SSL/TLS
# =============================================================================
SSL_ENABLED=true
ACME_EMAIL=admin@local

# =============================================================================
# BACKEND - MySQL
# =============================================================================
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_DATABASE=abs_db
MYSQL_USER=abs_user
MYSQL_PASSWORD=abs_secret

# =============================================================================
# BACKEND - PostgreSQL
# =============================================================================
POSTGRES_DB=abs_db
POSTGRES_USER=abs_user
POSTGRES_PASSWORD=abs_secret

# =============================================================================
# BACKEND - MongoDB
# =============================================================================
MONGO_INITDB_DATABASE=abs_db
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=mongo_secret

# =============================================================================
# BACKEND - Redis
# =============================================================================
# REDIS_PASSWORD=redis_secret

# =============================================================================
# BACKEND - PHP
# =============================================================================
XDEBUG_MODE=off
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_MAX_FILESIZE=100M
PHP_POST_MAX_SIZE=100M

# =============================================================================
# RÉSEAUX DOCKER
# =============================================================================
NETWORK_FRONTEND=abs_frontend_network
NETWORK_BACKEND=abs_backend_network
NETWORK_SERVICES=abs_services_network

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=DEBUG
TRAEFIK_LOG_LEVEL=DEBUG
KEYCLOAK_LOG_LEVEL=INFO
