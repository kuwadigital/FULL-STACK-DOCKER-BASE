# =============================================================================
# FRONTEND LOCAL ENVIRONMENT OVERRIDES
# =============================================================================
# Ce fichier permet de surcharger les variables globales si nécessaire.
# Les variables principales sont définies dans le .env à la racine du projet.
#
# Pour utiliser ce fichier en standalone (sans le .env global):
# docker-compose --env-file .env up -d
#
# Pour utiliser avec le .env global (via Makefile):
# make start-frontend  (utilise automatiquement le .env global)
# =============================================================================

# --- Surcharges locales (décommenter si nécessaire) ---

# NODE_VERSION=22
# REDIS_FRONTEND_VERSION=7
# NGINX_FRONTEND_VERSION=1.27

# NODE_ENV=development

# FRONTEND_DEV_PORT=5173
# FRONTEND_PREVIEW_PORT=4173
# FRONTEND_PROD_PORT=3000
# REDIS_FRONTEND_PORT=6380

# VITE_HOST=0.0.0.0
