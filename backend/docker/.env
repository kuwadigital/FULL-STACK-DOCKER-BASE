# =============================================================================
# BACKEND LOCAL ENVIRONMENT OVERRIDES
# =============================================================================
# Ce fichier permet de surcharger les variables globales si nécessaire.
# Les variables principales sont définies dans le .env à la racine du projet.
#
# Pour utiliser ce fichier en standalone (sans le .env global):
# docker-compose --env-file .env up -d
#
# Pour utiliser avec le .env global (via Makefile):
# make start-backend  (utilise automatiquement le .env global)
# =============================================================================

# --- Surcharges locales (décommenter si nécessaire) ---

# PHP_VERSION=8.3
# NGINX_BACKEND_VERSION=1.27
# MYSQL_VERSION=8.0
# POSTGRES_VERSION=16
# MONGO_VERSION=7
# REDIS_BACKEND_VERSION=7

# XDEBUG_MODE=debug

# BACKEND_PORT=8000
# MYSQL_PORT=3306
# POSTGRES_PORT=5432
# MONGO_PORT=27017
# REDIS_BACKEND_PORT=6379
# ADMINER_PORT=8081

# MySQL
# MYSQL_ROOT_PASSWORD=root_secret
# MYSQL_DATABASE=abs_db
# MYSQL_USER=abs_user
# MYSQL_PASSWORD=abs_secret

# PostgreSQL
# POSTGRES_DB=abs_db
# POSTGRES_USER=abs_user
# POSTGRES_PASSWORD=abs_secret

# MongoDB
# MONGO_INITDB_DATABASE=abs_db
# MONGO_INITDB_ROOT_USERNAME=root
# MONGO_INITDB_ROOT_PASSWORD=mongo_secret
